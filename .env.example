# ==========================================
# Dev Log Admin - Root Environment Config
# ==========================================

# Ports
LEGACY_PORT=8100
BACKEND_PORT=8200
FRONTEND_PORT=3000

# Database
DATABASE_URL=postgresql+asyncpg://localhost/devlog
SQLITE_PATH=./legacy/devlog.db

# Security (generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-this-in-production
JWT_SECRET=change-this-in-production

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8200/api/v2/github/callback
