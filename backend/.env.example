# Application
APP_NAME="Dev Log Admin API"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8100

# Database
DATABASE_URL=postgresql://localhost/devlog

# SQLite (for migration only)
SQLITE_PATH=../devlog.db

# Security
SECRET_KEY=change-this-in-production-use-long-random-string
JWT_SECRET=jwt-secret-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8100"]
